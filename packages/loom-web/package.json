{
  "name": "@loom-ai/web",
  "version": "5.40.0",
  "description": "Loom web dashboard — local Express + vanilla-JS UI over the SQLite state",
  "license": "UNLICENSED",
  "homepage": "https://github.com/jeromeportega/loom",
  "repository": { "type": "git", "url": "git+https://github.com/jeromeportega/loom.git" },
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "type": "commonjs",
  "scripts": {
    "build": "rm -rf dist && tsc && npm run copy:public",
    "copy:public": "mkdir -p dist/public && cp -R public/. dist/public/",
    "dev": "tsc --watch",
    "test": "node --test $(find dist -path '*__tests__*' -name '*.test.js')"
  },
  "files": ["dist", "public"],
  "dependencies": {
    "@loom-ai/core": "^5.40.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
