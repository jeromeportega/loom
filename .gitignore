node_modules/

# In-session worktrees created by Agent tool isolation — never useful to track.
.claude/worktrees/

# Operator-local logs (loom run output, etc.).
logs/

# Untracked bench-run output artifacts at repo root (loom bench writes these).
loom.loom-*.json

# BMAD was used only to bootstrap-plan loom — it is not a runtime dependency.
# Reproducible via `npx bmad-method install`; see docs/BOOTSTRAP.md.
.bmad/
_bmad/
# planning artifacts are committed; only ignore generated/temp outputs
_bmad-output/generated/
*.user.toml
.DS_Store
# loom runtime — local only; everything else under .loom/ is team-shared
.loom/loom.db*
.loom/worktrees/
dist/
# Vite SPA bundle output (loom-web React client build).
client-dist/
# TypeScript incremental build info cache — regenerated on each build.
*.tsbuildinfo
# Test-only compile output (packages/loom-core/tsconfig.test.json → dist-test/).
dist-test/
# MkDocs build output — generated by scripts/docs/{serve,deploy}.sh
site/

# Eval harness output — produced by scripts/eval-intake.mjs; never committed (FR-12).
.loom/eval/

# >>> loom-managed (edit BELOW or ABOVE these markers; this block is regenerated) >>>
# To track something loom ignores by default (e.g. share planning artifacts),
# add the negation OUTSIDE these markers — patterns later in .gitignore win.
# Example: a line  `!.loom/planning/`  below this block keeps plans tracked.

# Local-only state (per machine, never useful to check in):
.loom/loom.db*
.loom/worktrees/
# Nested package-level .loom state dirs created when running loom from a
# workspace subdir (e.g. packages/loom-core/.loom/loom.db) — local-only.
**/.loom/loom.db*
packages/*/.loom/

# Generated planning working directory — the EpicFinalizer promotes the
# final brief / PRD / architecture / epic.yaml for each *delivered* epic
# into .loom_outputs/<epic-id>/ (committed to the epic branch), so the
# .loom/planning/ working files do not need to be tracked.
.loom/planning/

# Worker scratch space — probes, exploratory scripts, investigation
# notes. The worker prompt directs agents to write scratch here so it
# does not pollute the PR diff.
.loom/scratch/

# Per-story signal records written by SignalLedger — runtime state,
# never committed (story-010-002, NFR-3).
.loom/signals/

# Per-story durable worker log files (story-019-001). Full post-redaction
# output appended at stream time; never committed (content is machine-local
# and grows unboundedly across runs).
.loom/logs/

# Per-machine integration files (paths bake in your local install; regenerable via `loom init`):
.claude/settings.json
.claude/skills/loom-*/
.mcp.json
.cursor/mcp.json
.cursor/rules/loom.mdc
# <<< loom-managed <<<

# Track epic-040 planning artifacts (and any future epic planning files).
# Each new epic's artifacts need a corresponding !.loom/planning/<epic>/ and
# !.loom/planning/<epic>/** pair, or just add !.loom/planning/**/** to cover all.
!.loom/planning/
!.loom/planning/epic-040/
!.loom/planning/epic-040/**
